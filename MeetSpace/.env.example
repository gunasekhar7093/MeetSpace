# ==============================================================================
# MeetSpace Frontend Environment Variables (.env.example)
# ==============================================================================

# Backend REST API Base URL
# Development: http://localhost:5000/api
# Production: https://api.yourdomain.com/api (or /api if served through reverse proxy)
VITE_API_BASE_URL=http://localhost:5000/api

# Real-Time Socket.IO Server URL
# Development: http://localhost:5000
# Production: https://api.yourdomain.com (or leave empty if using relative reverse-proxy path)
VITE_SOCKET_URL=http://localhost:5000

# Optional STUN / ICE Fallback Server URL
VITE_STUN_SERVER_URL=stun:stun.l.google.com:19302
