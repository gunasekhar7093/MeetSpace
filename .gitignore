# Root .gitignore for MeetSpace

# Node dependencies
node_modules/
package-lock.json.bak

# Environment variables & secrets
.env
.env.*
.env.local
.env.*.local
!.env.example

# Build artifacts
dist/
dist-ssr/
build/

# Binaries & executables
*.exe
bin/
*.dll
*.so
*.dylib

# Local databases & data directories
backend/data/
backend/backend/
*.wt
*.lock
diagnostic.data/
journal/
!MeetSpace/src/data/

# Meeting recordings & media files
recordings/
backend/recordings/
**/recordings/
*.mp4
*.webm
*.mkv

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test artifacts & temporary files
coverage/
.nyc_output/
tmp/
temp/

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
