# ==============================================================================
# MeetSpace Backend Environment Variables Reference (.env.example)
# Copy this file to .env and configure values for your environment.
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# Server Environment
PORT=5000
# Allowed values: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Connection String (TLS enabled for Atlas)
# In production, use your MongoDB Atlas replica set URI with TLS and credentials
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/meetspace_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/meetspace_dev

# JWT Authentication Secrets
# In production, these MUST be unique, cryptographically random strings (min 32 characters).
# Development placeholder secrets are rejected at startup in production mode.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret_min_32_characters
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret_min_32_characters

# Token Expiration Settings
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS & Cookie domain)
# In production, set to your canonical domain (e.g., https://meetspace.app)
# Comma-separated list supported for multiple origins.
FRONTEND_URL=http://localhost:5173

# LiveKit SFU Media Server (Audio, Video, Screen Sharing)
# For local development: ws://127.0.0.1:7880 with devkey/secret
# For production: MUST use wss://<livekit-domain> with high-entropy API key & secret
# Production startup will fail if default development credentials ('devkey'/'secret') are used.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret

# LiveKit Egress / Meeting Recording Configuration
# MOCK_EGRESS is ONLY permitted in development/test.
# In production, MOCK_EGRESS=true is strictly prohibited and rejected at startup.
MOCK_EGRESS=false

# Recording Storage Type: 'local' (development only) or 's3' (production object storage)
# In production, 'local' storage is discouraged unless mounting a durable persistent volume.
EGRESS_STORAGE_TYPE=local
RECORDINGS_DIR=./recordings

# Production S3 / Object Storage (Required when EGRESS_STORAGE_TYPE=s3)
EGRESS_S3_KEY=replace_with_aws_access_key_id
EGRESS_S3_SECRET=replace_with_aws_secret_access_key
EGRESS_S3_BUCKET=meetspace-recordings-bucket
EGRESS_S3_REGION=us-east-1
# Optional custom S3 endpoint (e.g., MinIO, Cloudflare R2, Wasabi)
# EGRESS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
